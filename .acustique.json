{
  "$comment": "acustique product config (schema: acustique templates/acustique.schema.json). A static site on Cloudflare Workers, not Odoo modules, so the website surface's scan paths are set here. Run: node <acustique>/checks/run.mjs --root .",
  "product": "timeperative-website",
  "mode": "report-only",
  "copy": {
    "scan": ["src", "README.md"],
    "extensions": [".html", ".json", ".md"],
    "german": ["src/pages/de/**", "src/i18n/de.json"]
  },
  "colours": {
    "scan": ["src"],
    "extensions": [".css", ".html", ".js"],
    "exempt": ["src/static/assets/tokens.css"]
  },
  "tokens": {
    "files": ["src/static/assets/tokens.css"]
  },
  "probe": {
    "urls": ["https://www.timeperative.com/", "https://www.timeperative.com/download/", "https://www.timeperative.com/resources/features/", "https://www.timeperative.com/resources/converters/", "https://www.timeperative.com/support/", "https://www.timeperative.com/privacy/", "https://www.timeperative.com/de/", "https://www.timeperative.com/fr/", "https://www.timeperative.com/es/"],
    "widths": [1280, 360],
    "theme": { "storageKey": "ty-scheme", "attribute": "data-bs-theme", "toggle": "[data-scheme-cycle]", "default": "dark" }
  }
}
