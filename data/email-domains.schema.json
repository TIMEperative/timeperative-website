{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.timeperative.com/schemas/email-domains.schema.json",
  "title": "TIMEperative known email domain registry",
  "description": "Generated by scripts/email-domains.mjs; never edit by hand. One object per known provider domain, sorted by domain. The builder also checks what a schema cannot: one row per domain, canonical domains, the order.",
  "type": "array",
  "uniqueItems": true,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["domain", "type", "sources", "confidence"],
    "properties": {
      "domain": { "type": "string", "minLength": 3, "maxLength": 253, "pattern": "^[a-z0-9.-]+$" },
      "type": { "type": "string", "enum": ["WEBMAIL", "ISP_PERSONAL", "ALIAS", "DISPOSABLE", "CUSTOM_DOMAIN", "UNKNOWN"] },
      "sources": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": { "type": "string", "enum": ["timeperative-curated", "castle-disposable", "disposable-community", "forwarding-combined", "free-email-providers"] }
      },
      "confidence": { "type": "string", "enum": ["HIGH", "MEDIUM", "LOW"] }
    }
  }
}
