// Cloudflare Workers: the static site in dist/ (npm run build) with a small
// Worker for the download links (src/worker.js). Workers Static Assets is
// what Cloudflare recommends for new static sites instead of Pages
// (developers.cloudflare.com/workers/best-practices/workers-best-practices/,
// read 2026-10-18).
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "timeperative-website",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // Navigation requests prefer static assets (and their 404 page) since
    // compatibility date 2025-04-01, so the download links must run the
    // Worker first. Keep this list equal to site.json "workerRoutes".
    "run_worker_first": ["/download/windows", "/download/android"]
  },
  // The apex serves the site; www.timeperative.com and timely.you redirect
  // here with Cloudflare redirect rules (setup guides in Notion: TIMEperative >
  // TIMEperative.com website). A custom domain
  // needs the zone active on Cloudflare first.
  "routes": [{ "pattern": "timeperative.com", "custom_domain": true }]
}
